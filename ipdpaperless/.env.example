# ---------------------------------------------------------------------------
# IPDX (IPD Paperless) frontend environment configuration
# Copy this file to `.env.local` and adjust the values.
# ---------------------------------------------------------------------------

# Data source mode.
#   true  (default) -> use built-in mock data (no backend required)
#   false           -> fetch from the live FastAPI / PostgreSQL APIs
NEXT_PUBLIC_USE_MOCK=true

# FastAPI backend (Oracle 11g) base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API that serves data stored in PostgreSQL (data not available from Oracle).
# Leave unset to reuse NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_PG_API_BASE_URL=http://localhost:8001

# Simulated latency (ms) for mock mode.
NEXT_PUBLIC_MOCK_LATENCY_MS=250
