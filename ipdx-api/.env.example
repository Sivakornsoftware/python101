# ---------------------------------------------------------------------------
# IPDX API configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

APP_NAME=IPDX API
DEBUG=false

# Browser origins allowed by CORS (comma-separated). Add production origin later.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Repository backend: "mock" (no DB needed) or "oracle" (legacy HIS).
DB_BACKEND=mock

# --- Oracle 11g (legacy HIS) — required when DB_BACKEND=oracle --------------
ORACLE_USER=ipdx_ro
ORACLE_PASSWORD=change-me
# host:port/service_name  (use the STANDBY/backup DB while developing)
ORACLE_DSN=10.0.0.10:1521/ORCL
# Oracle Instant Client dir (THICK mode is mandatory for 11g).
# e.g. /opt/oracle/instantclient_19_24  — leave empty if on PATH/LD_LIBRARY_PATH.
ORACLE_LIB_DIR=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
